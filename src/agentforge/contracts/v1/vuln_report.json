{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentforge/contracts/v1/vuln_report",
  "title": "VulnReport",
  "version": "1",
  "description": "Documentation Agent draft output. It is generated from a schema-valid EXPLOIT_CONFIRMED or EXPLOIT_LIKELY Verdict plus approved sanitized evidence references, and confirmation_status states which. A report exists so a human can READ the evidence before deciding; it is not itself a claim that the finding is confirmed. This contract is intentionally draft-only; publication is a separate human-authorized boundary, and a candidate_unconfirmed report can never be published at all.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "finding_id",
    "campaign_run_id",
    "attempt_id",
    "source_case_id",
    "severity",
    "category",
    "confirmation_status",
    "description",
    "clinical_impact",
    "minimal_reproduction",
    "reproduction_sha256",
    "observed_behavior",
    "expected_behavior",
    "recommended_remediation",
    "status",
    "fix_validation",
    "evidence_references",
    "publication_state"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "report_id": { "type": "string", "minLength": 1, "maxLength": 80 },
    "finding_id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "campaign_run_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "attempt_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "source_case_id": { "type": "string", "minLength": 1, "maxLength": 120 },
    "severity": { "enum": ["low", "medium", "high", "critical"] },
    "category": { "type": "string", "minLength": 1, "maxLength": 120 },
    "confirmation_status": {
      "enum": ["confirmed", "candidate_unconfirmed"],
      "description": "Whether a deterministic oracle, canary or human confirmed this finding, or whether it rests solely on the model evaluator's opinion. 'confirmed' corresponds to an EXPLOIT_CONFIRMED verdict and a finding in state 'judged'. 'candidate_unconfirmed' corresponds to EXPLOIT_LIKELY and a finding in state 'candidate' — it means a reviewer has NOT yet accepted it and no deterministic signal corroborates it. Required, and duplicated into the stored column so the database constrains it: a candidate_unconfirmed report is permanently blocked_pending_human_approval and can never be published."
    },
    "description": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "clinical_impact": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "minimal_reproduction": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 4000 }
    },
    "reproduction_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "observed_behavior": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "model_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "rationale"],
      "description": "The Judge model's advisory reasoning about this attempt. It is NOT why the exploit was confirmed — that is stated by observed_behavior and by the verdict's confirmation_source, which is always an oracle, canary or human. The authority member is a constant so the advisory status survives being read as raw JSON, out of the console, or pasted into another document.",
      "properties": {
        "authority": { "const": "advisory_never_confirmatory" },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "criteria_hits": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 120 }
        }
      }
    },
    "expected_behavior": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "recommended_remediation": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "status": {
      "enum": ["draft", "validated", "remediation_pending", "fix_pending", "fixed", "regressed"]
    },
    "fix_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "summary", "evidence_references"],
      "properties": {
        "state": { "enum": ["not_run", "failed", "passed_for_right_reason"] },
        "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "evidence_references": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/evidence_reference" }
        }
      }
    },
    "evidence_references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/evidence_reference" }
    },
    "publication_state": {
      "enum": ["draft_unpublished", "blocked_pending_human_approval"]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "severity": { "const": "critical" } } },
      "then": {
        "properties": {
          "publication_state": { "const": "blocked_pending_human_approval" }
        }
      }
    },
    {
      "if": {
        "properties": { "confirmation_status": { "const": "candidate_unconfirmed" } },
        "required": ["confirmation_status"]
      },
      "then": {
        "properties": {
          "publication_state": { "const": "blocked_pending_human_approval" },
          "status": { "const": "draft" }
        },
        "required": ["model_assessment"]
      }
    }
  ],
  "$defs": {
    "evidence_reference": {
      "type": "string",
      "pattern": "^evidence://sha256/[0-9a-f]{64}$",
      "maxLength": 82
    }
  }
}
